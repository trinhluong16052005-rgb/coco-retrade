@model IReadOnlyList<OrderDto>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var group = (string?)ViewBag.Group;
    var sellerNames = (IReadOnlyDictionary<string, string>)ViewBag.SellerNames;
    const int pageSize = 10;
    var pageCount = Math.Max(1, (Model.Count + pageSize - 1) / pageSize);
    var pageNumber = int.TryParse(Context.Request.Query["page"].FirstOrDefault(), out var requestedPage) ? Math.Clamp(requestedPage, 1, pageCount) : 1;
}
<link rel="stylesheet" href="~/css/admin-bulk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-lists.css" asp-append-version="true" />
<div class="admin-list-page admin-orders-page">
    <header class="admin-page-header">
        <div><div class="eyebrow">Vận hành cửa hàng</div><h1 class="page-title">Đơn hàng</h1><p class="subtitle mb-0">Mở một đơn để xử lý giao nhận và cập nhật tiến độ.</p></div>
        <div class="admin-list-header-actions"><span class="admin-status">@Model.Count kết quả</span><a class="btn btn-outline-wine btn-sm" asp-action="HeldPickups">Xem hàng tạm giữ chờ lấy <span aria-hidden="true">→</span></a></div>
    </header>
    <form method="get" class="panel admin-toolbar mb-4">
        <partial name="_DashboardRangeFields" />
        @if (ViewBag.DashboardFrom is not null)
        {
            <input type="hidden" name="status" value="@ViewBag.DashboardStatus" />
            <input type="hidden" name="paymentStatus" value="@ViewBag.DashboardPayment" />
            <input type="hidden" name="basis" value="@ViewBag.DashboardBasis" />
        }
        <div class="flex-grow-1"><label class="form-label" for="orderSearch">Tìm đơn hàng</label><input class="form-control" id="orderSearch" type="search" name="search" value="@ViewBag.Search" placeholder="Mã đơn, tên sản phẩm, mã SKU hoặc người ký gửi" /></div>
        <div><label class="form-label" for="orderGroup">Nhóm đơn hàng</label><select class="form-select" id="orderGroup" name="group"><option value="">Tất cả đơn hàng</option><option value="active" selected="@(group == "active")">Đang xử lý</option><option value="shipping" selected="@(group == "shipping")">Đang giao hàng</option><option value="ready" selected="@(group == "ready")">Chờ nhận tại Shop</option><option value="completed" selected="@(group == "completed")">Đã hoàn tất</option><option value="cancelled" selected="@(group == "cancelled")">Đã hủy</option></select></div>
        <button class="btn btn-wine" type="submit"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#filter" /></svg> Áp dụng</button>
        @if (ViewBag.DashboardFrom is not null || !string.IsNullOrWhiteSpace((string?)ViewBag.Search) || !string.IsNullOrEmpty(group)) { <a class="btn btn-outline-wine" asp-action="Index">Xóa lọc</a> }
    </form>
    <partial name="_DashboardSelection" />
    <div class="panel admin-list-panel mb-5">
        @if (Model.Count == 0)
        {
            <div class="empty-state border-0"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#package" /></svg><h2 class="fs-4 mt-3">Chưa có đơn hàng</h2><p class="mb-0">Đơn mới sẽ xuất hiện tại đây khi khách hoàn tất đặt hàng.</p></div>
        }
        else
        {
            <div class="table-responsive" role="region" aria-label="Danh sách đơn hàng, có thể cuộn ngang" tabindex="0">
                <table class="table admin-table admin-list-table align-middle mb-0"><caption class="visually-hidden">Danh sách đơn hàng và tiến độ xử lý</caption>
                    <thead><tr><th scope="col">Đơn hàng</th><th scope="col">Sản phẩm</th><th scope="col">Người ký gửi</th><th scope="col">Giao nhận</th><th scope="col">Tổng thanh toán</th><th scope="col" class="admin-list-status">Trạng thái</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead>
                    <tbody>
                        @foreach (var order in Model.Skip((pageNumber - 1) * pageSize).Take(pageSize))
                        {
                            var (statusLabel, statusTone) = order.Status switch
                            {
                                OrderStatus.PendingProcessing => ("Chờ xử lý", "pending"),
                                OrderStatus.Shipping => ("Đang giao", "shipping"),
                                OrderStatus.ReadyForPickup => ("Chờ nhận tại Shop", "ready"),
                                OrderStatus.Completed when order.Fulfillment == FulfillmentType.Pickup => ("Đã nhận tại Shop", "pickup"),
                                OrderStatus.Completed => ("Hoàn tất", "completed"),
                                OrderStatus.Cancelled => ("Đã hủy", "cancelled"),
                                _ => (UiText.For(order.Status), "neutral")
                            };
                            <tr>
                                <td><div class="admin-list-identity"><strong class="admin-code">@order.OrderCode</strong><small class="text-muted admin-list-date">@order.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</small></div></td>
                                <td><div class="admin-list-identity"><strong>@order.ProductName</strong><small class="admin-code">@order.ProductSku</small></div></td>
                                <td>@sellerNames.GetValueOrDefault(order.SellerId, "—")</td>
                                <td>@UiText.For(order.Fulfillment)</td>
                                <td class="admin-list-amount">@order.TotalAmount.ToString("N0") VNĐ</td>
                                <td class="admin-list-status"><span class="admin-status admin-list-badge admin-list-badge--@statusTone">@statusLabel</span></td>
                                <td><div class="admin-row-actions"><a class="btn btn-outline-wine btn-sm" asp-action="Details" asp-route-id="@order.Id">Xem chi tiết <span aria-hidden="true">→</span></a></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_AdminListPagination" model="@((Model.Count, pageNumber, pageSize))" />
        }
    </div>
</div>
