@model AdminProductDetails
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><partial name="~/Views/Shared/_PhoneViewport.cshtml" />
<title>Tem @Model.Product.Sku</title><link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" /><style>
body{font-family:"Open Sans",sans-serif;margin:24px;color:#000000;background:#FFFFFF}.label{width:80mm;min-height:58mm;border:1px solid #000000;padding:5mm;box-sizing:border-box}
.brand img{display:block;width:24mm;height:auto}.sku{font-size:18px;font-weight:800;margin:9px 0;word-break:break-all}.muted{font-size:11px;color:#000000}
.codes{display:flex;gap:4mm;align-items:center;margin:3mm 0}.qr{width:22mm;height:22mm;flex:none}.qr svg{width:100%;height:100%}
button{margin-top:20px;padding:10px 18px;cursor:pointer;font-family:inherit;font-weight:700;background:#F83758;color:#000000;border:1px solid #F83758}button:hover{background:#F8DDE5;border-color:#000000}@@media print{body{margin:0}button{display:none}.label{border:0}}
@@media screen and (max-width:767.98px){body{margin:12px}.label{max-width:100%}}
</style></head><body><div class="label"><div class="brand"><img src="~/images/coco-logo.svg" alt="CoCo ReTrade" /></div>
<div class="codes"><div class="qr">@Html.Raw(SkuQrCode.Svg(Model.Product.Sku))</div><div class="sku">@Model.Product.Sku</div></div>
<div>@Model.Product.Name · @Model.Product.Brand · @UiText.For(Model.Product.Size)</div><div class="muted">Mã chờ duyệt @Model.Product.ConsignmentCode</div></div>
<button onclick="window.print()">In tem</button><partial name="~/Views/Shared/_MobileNavigation.cshtml" /></body></html>
