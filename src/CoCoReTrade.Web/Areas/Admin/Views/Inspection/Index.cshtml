@model IReadOnlyList<AdminProductItem>
@{
    ViewData["Title"] = "Ký gửi chờ kiểm định";
    var stage = (string?)ViewBag.Stage;
    const int pageSize = 10;
    var pageCount = Math.Max(1, (Model.Count + pageSize - 1) / pageSize);
    var pageNumber = int.TryParse(Context.Request.Query["page"].FirstOrDefault(), out var requestedPage) ? Math.Clamp(requestedPage, 1, pageCount) : 1;
}
<link rel="stylesheet" href="~/css/admin-bulk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin-lists.css" asp-append-version="true" />
<div class="admin-list-page">
    <header class="admin-page-header">
        <div><div class="eyebrow">Kiểm định CoCo</div><h1 class="page-title">@(stage == "rejected" ? "Ký gửi đã từ chối" : "Ký gửi chờ xử lý")</h1><p class="subtitle mb-0">Duyệt ảnh trước khi nhận đồ. Kiểm định hiện vật và xác nhận thông tin trước khi đăng bán.</p></div>
        <span class="admin-status admin-status--warning">@Model.Count kết quả</span>
    </header>
    <form method="get" class="panel admin-toolbar mb-4">
        <partial name="_DashboardRangeFields" />
        <div class="flex-grow-1"><label class="form-label" for="inspectionSearch">Tìm sản phẩm ký gửi</label><input class="form-control" id="inspectionSearch" type="search" name="search" value="@ViewBag.Search" placeholder="Nhập mã chờ duyệt, tên sản phẩm hoặc người bán" /></div>
        <div><label class="form-label" for="inspectionStage">Giai đoạn</label><select class="form-select" id="inspectionStage" name="stage"><option value="">Tất cả chờ xử lý</option><option value="preliminary" selected="@(stage == "preliminary")">Chưa duyệt sơ bộ</option><option value="approved" selected="@(stage == "approved")">Đã duyệt sơ bộ</option><option value="changes" selected="@(stage == "changes")">Đang đợi cập nhật</option>@if (User.HasClaim(StaffPermissions.ClaimType, StaffPermissions.ManageProducts)) { <option value="rejected" selected="@(stage == "rejected")">Đã từ chối</option> }</select></div>
        <button class="btn btn-wine" type="submit"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#filter" /></svg> Áp dụng</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Search) || stage is not null) { <a class="btn btn-outline-wine" asp-action="Index">Xóa lọc</a> }
    </form>
    <partial name="_DashboardSelection" />
    <div class="panel admin-list-panel mb-5">
        @if (Model.Count == 0)
        {
            <div class="empty-state border-0"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#clipboard" /></svg><h2 class="fs-4 mt-3">Không có sản phẩm phù hợp</h2><p class="mb-0">Thử tìm bằng mã khác, hoặc quay lại khi có ký gửi mới.</p></div>
        }
        else
        {
            <div class="table-responsive" role="region" aria-label="Danh sách ký gửi, có thể cuộn ngang" tabindex="0">
                <table class="table admin-table admin-list-table align-middle mb-0"><caption class="visually-hidden">Sản phẩm ký gửi và giai đoạn kiểm định</caption>
                    <thead><tr><th scope="col">Sản phẩm</th><th scope="col">Mã chờ duyệt</th><th scope="col">SKU chính thức</th><th scope="col">Người ký gửi</th><th scope="col">Ngày gửi</th><th scope="col">Giai đoạn</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Skip((pageNumber - 1) * pageSize).Take(pageSize))
                        {
                            <tr>
                                <td><div class="admin-product-identity">
                                    @if (p.CoverImageId.HasValue) { <img class="admin-product-thumb" src="/images/@p.CoverImageId" alt="@p.Name" width="64" height="64" loading="lazy" /> }
                                    else { <span class="admin-product-thumb admin-product-thumb--empty" aria-label="Chưa có ảnh"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#image" /></svg></span> }
                                    <div><strong>@p.Name</strong><div class="small text-muted">@p.Brand</div></div>
                                </div></td>
                                <td><span class="admin-code">@p.ConsignmentCode</span></td>
                                <td><span class="admin-code">@(string.IsNullOrEmpty(p.Sku) ? "Chưa cấp" : p.Sku)</span></td>
                                <td>@p.SellerName</td>
                                <td class="admin-list-date">@p.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy")</td>
                                <td class="admin-list-status"><span class="admin-status admin-status--warning">@(p.Status == ProductStatus.Rejected ? "Đã từ chối" : p.PreliminaryStatus == PreliminaryReviewStatus.Approved ? "Chờ kiểm định trực tiếp" : p.PreliminaryStatus == PreliminaryReviewStatus.ChangesRequested ? "Cần cập nhật" : "Chờ duyệt sơ bộ")</span></td>
                                <td><div class="admin-row-actions"><a class="btn btn-outline-wine btn-sm" asp-action="@(p.Status == ProductStatus.Rejected ? "Details" : "Review")" asp-route-id="@p.Id" title="@(p.Status == ProductStatus.Rejected ? "Xem chi tiết" : p.PreliminaryStatus == PreliminaryReviewStatus.Approved ? "Mở phiếu kiểm định" : "Mở phiếu duyệt sơ bộ")">@(p.Status == ProductStatus.Rejected ? "Chi tiết" : p.PreliminaryStatus == PreliminaryReviewStatus.Approved ? "Kiểm định" : "Duyệt sơ bộ") <span aria-hidden="true">→</span></a></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_AdminListPagination" model="@((Model.Count, pageNumber, pageSize))" />
        }
    </div>
</div>
