@model CheckoutRecommendations
@{
    var groups = new[]
    {
        (Id: "checkout-recommendations-title", Title: "Có thể bạn cũng thích", Items: Model.CrossSell, CanAdd: true),
        (Id: "checkout-similar-title", Title: "Các sản phẩm tương tự", Items: Model.Similar, CanAdd: false)
    };
}
@foreach (var group in groups)
{
    if (group.Items.Count == 0) continue;
    <section class="checkout-recommendations" aria-labelledby="@group.Id">
        <h2 id="@group.Id">@group.Title</h2>
        <div class="checkout-cross-sell" tabindex="0" role="region" aria-labelledby="@group.Id">
            @foreach (var product in group.Items)
            {
                <article data-recommended-product="@product.Id">
                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">
                        @if (product.CoverImageId.HasValue)
                        {
                            <partial name="_ProductCardPhoto" model="product" />
                        }
                        else
                        {
                            <div class="product-image-frame checkout-recommendation-placeholder" aria-hidden="true">
                                <svg class="icon"><use href="/images/icons.svg#bag" /></svg>
                            </div>
                        }
                        <span>@product.Brand</span>
                        <h3 title="@product.Name">@product.Name</h3>
                    </a>
                    <strong>@product.AskingPrice.ToString("N0") VNĐ</strong>
                    @if (group.CanAdd && product.SellerId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" data-checkout-add>
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="returnUrl" value="/Cart" />
                            <button type="submit" class="btn btn-outline-wine w-100">Thêm vào giỏ</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-wine w-100" asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" aria-label="Xem chi tiết @product.Name">Xem chi tiết</a>
                    }
                </article>
            }
        </div>
    </section>
}
