@model IReadOnlyList<ProductCard>
@inject CoCoReTrade.Web.Demo.DemoCatalog Demo
@{
    var savedIds = ((IEnumerable<Guid>?)ViewBag.FavoriteIds ?? []).ToHashSet();
    var selection = ViewBag.ProductSelection as string;
    var selectionForm = selection == "saved" ? "saved-selection-form" : "closet-selection-form";
    var viewerId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
@if (Model.Count == 0)
{
    <div class="empty-state"><div class="empty-icon"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag" /></svg></div><h3>Chưa tìm thấy món đồ phù hợp</h3><p>Thử từ khóa khác hoặc giảm số bộ lọc.</p><a class="btn btn-outline-wine mt-2" asp-area="" asp-controller="Shop" asp-action="Index">Khám phá tất cả</a></div>
}
else
{
    <div class="product-grid" tabindex="@(ViewBag.ProductRail == true ? "0" : null)"
         role="@(ViewBag.ProductRail == true ? "region" : null)"
         aria-label="@(ViewBag.ProductRail == true ? "Sản phẩm gợi ý" : null)">
    @foreach (var p in Model)
    {
        var demoProduct = Demo.Find(p.Sku);
        <div class="col" id="@(ViewBag.IsCloset == true ? "consignment-" + p.Id : null)" data-product-item="@p.Id" data-product-status="@p.Status"><article class="product-card">
            <div class="product-card-media">
                @if (selection is "saved" or "closet")
                {
                    var canSelect = selection == "saved" || p.CanRemoveFromCloset;
                    <label class="product-selection @(canSelect ? "" : "is-locked")" title="@(canSelect ? "Chọn món đồ" : "Chỉ xóa món chưa kiểm định chính thức và chưa đăng bán.")">
                        <input type="checkbox" name="ids" value="@p.Id" form="@selectionForm" data-product-select disabled="@(!canSelect)" />
                        <span class="visually-hidden">Chọn @p.Name@(canSelect ? "" : " · Không thể xóa")</span>
                    </label>
                }
                <a class="product-photo" asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id">
                    @if (p.CoverImageId.HasValue) { <partial name="_ProductCardPhoto" model="p" /> }
                    else { <span class="product-placeholder"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag" /></svg></span> }
                    @if (demoProduct is not null) { <span class="verified-badge">Minh họa · Mô phỏng</span> }
                </a>
                @if (p.Status == ProductStatus.Active)
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-area="" asp-controller="Social" asp-action="Favorite" method="post" class="product-card-favorite" data-favorite data-product-name="@p.Name">
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="selected" value="@(!savedIds.Contains(p.Id) ? "true" : "false")" />
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <button class="favorite-button @(savedIds.Contains(p.Id) ? "is-saved" : "")" type="submit" aria-label="@(savedIds.Contains(p.Id) ? "Bỏ lưu" : "Lưu") @p.Name" aria-pressed="@(savedIds.Contains(p.Id) ? "true" : "false")"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path data-favorite-shape fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" /></svg></button>
                        </form>
                    }
                    else { <a class="favorite-button product-card-favorite" asp-area="" asp-controller="Account" asp-action="Login" aria-label="Đăng nhập để lưu @p.Name"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg></a> }
                }
            </div>
            <div class="product-body">
                <div class="product-card-summary">
                <div class="product-card-brand">@p.Brand</div>
                <h3><a asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@p.Id" title="@p.Name">@p.Name</a></h3>
                <div class="product-meta"><span class="product-size" title="Cỡ @UiText.For(p.Size)">Cỡ @UiText.For(p.Size)</span><span class="product-condition">Tình trạng @p.ConditionPercent%</span></div>
                @if (demoProduct is not null) { <div class="product-demo-meta">@demoProduct.Color · Giá tham khảo</div> }
                @if (p.Status != ProductStatus.Active && !string.IsNullOrEmpty(p.ConsignmentCode)) { <div class="small text-muted mt-1">Mã chờ duyệt: @p.ConsignmentCode</div> }
                @if (ViewBag.IsCloset == true && p.Status == ProductStatus.PendingApproval)
                {
                    <div class="small mt-2">@(p.PreliminaryStatus == PreliminaryReviewStatus.Approved ? "Đã duyệt sơ bộ · Chờ kiểm định tại CoCo" : p.PreliminaryStatus == PreliminaryReviewStatus.ChangesRequested ? "CoCo yêu cầu cập nhật" : "Chờ duyệt sơ bộ")</div>
                    @if (!string.IsNullOrWhiteSpace(p.PreliminaryReason)) { <p class="small text-danger mb-1">@p.PreliminaryReason</p> }
                    @if (p.PreliminaryStatus != PreliminaryReviewStatus.Approved)
                    { <a class="btn btn-outline-wine btn-sm mt-2" asp-area="" asp-controller="Listing" asp-action="Edit" asp-route-id="@p.Id">Sửa thông tin và ảnh</a> }
                }
                </div>
                <div class="product-price-row d-flex flex-wrap justify-content-between align-items-center gap-1"><span class="product-price">@p.AskingPrice.ToString("N0") VNĐ</span>
                @if (p.Status != ProductStatus.Active || p.SellerId == viewerId) { <span class="status-pill product-sale-status @p.Status">@(p.Status == ProductStatus.Active ? "Chưa bán" : UiText.For(p.Status))</span> }
                else if (p.LikeCount > 0) { <span class="product-likes" aria-label="@p.LikeCount lượt yêu thích"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg> @p.LikeCount</span> }</div>
                <partial name="_ProductPurchaseActions" model="p" />
                @if (!string.IsNullOrWhiteSpace(p.SellerName))
                {
                    <div class="product-seller small d-flex align-items-center gap-2">
                        @if (p.SellerHasAvatar) { <img class="seller-avatar seller-avatar-small" src="/avatars/@p.SellerId" alt="" loading="lazy" /> }
                        else { <span class="seller-initial" aria-hidden="true">@p.SellerName.Trim()[0]</span> }
                        <a asp-area="" asp-controller="Sellers" asp-action="Index" asp-route-id="@p.SellerId">@p.SellerName</a>
                    </div>
                }
                else if (ViewBag.AlignProductCards == true)
                {
                    <div class="product-seller product-seller-empty" aria-hidden="true"></div>
                }
            </div>
        </article></div>
    }
    </div>
}
