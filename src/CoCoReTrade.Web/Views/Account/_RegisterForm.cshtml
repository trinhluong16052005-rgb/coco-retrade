@model RegisterForm
@inject AccountDeliveryStatus Delivery
@{ var returnUrl = ViewData["AuthReturnUrl"] as string ?? "/"; }
<section class="coco-auth-pane" data-auth-pane="register" data-auth-return-url="@returnUrl">
    <nav class="auth-mode-tabs" aria-label="Tài khoản CoCo">
        <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" data-auth-switch>Đăng nhập</a>
        <a asp-area="" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl" aria-current="page" data-auth-switch>Đăng ký</a>
    </nav>
    <header class="coco-auth-heading"><h2 tabindex="-1" data-auth-title>Bắt đầu cùng CoCo.</h2><p>Một tài khoản, nhiều món đồ hợp gu.</p></header>
    @if (!Delivery.EmailReady) { <p class="coco-auth-notice" role="status">Đăng ký qua email đang chờ bật dịch vụ gửi mã xác thực.</p> }
    <form asp-area="" asp-controller="Account" asp-action="Register" method="post" data-auth-form>
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger auth-validation" role="alert"></div>
        <div class="coco-auth-field"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" autocomplete="name" placeholder="Họ và tên của bạn" required minlength="2" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
        <div class="auth-register-contact">
            <div class="coco-auth-field"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="Email của bạn" required /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="coco-auth-field"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" inputmode="tel" autocomplete="tel" placeholder="Số điện thoại" required pattern="0[35789][0-9]{8}" maxlength="10" /><span asp-validation-for="Phone" class="text-danger small"></span></div>
        </div>
        <div class="coco-auth-field"><label asp-for="Password"></label><div class="auth-password-field"><input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="Từ 8 ký tự, gồm chữ thường và số" required minlength="8" /><button class="auth-password-toggle" type="button" data-auth-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button></div><span asp-validation-for="Password" class="text-danger small"></span></div>
        <div class="coco-auth-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Nhập lại mật khẩu" required minlength="8" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
        <button class="btn btn-wine coco-auth-submit" type="submit">Tạo tài khoản</button>
    </form>
    <partial name="_GoogleSignIn" />
    <p class="coco-auth-footer">CoCo gửi mã xác thực qua email để hoàn tất đăng ký.</p>
</section>
