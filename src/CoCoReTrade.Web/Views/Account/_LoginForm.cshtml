@model LoginForm
@{ var returnUrl = ViewData["AuthReturnUrl"] as string ?? "/"; }
<section class="coco-auth-pane" data-auth-pane="login" data-auth-return-url="@returnUrl">
    <nav class="auth-mode-tabs" aria-label="Tài khoản CoCo">
        <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" aria-current="page" data-auth-switch>Đăng nhập</a>
        <a asp-area="" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl" data-auth-switch>Đăng ký</a>
    </nav>
    <header class="coco-auth-heading"><h2 tabindex="-1" data-auth-title>Chào bạn trở lại</h2><p>Đăng nhập để tiếp tục cùng CoCo.</p></header>
    @if (TempData["Error"] is string error) { <p class="coco-auth-notice" role="alert">@error</p> }
    @if (TempData["Message"] is string message) { <p class="coco-auth-notice" role="status">@message</p> }
    <form asp-area="" asp-controller="Account" asp-action="Login" method="post" data-auth-form>
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger auth-validation" role="alert"></div>
        <div class="coco-auth-field"><label asp-for="Identifier"></label><input asp-for="Identifier" class="form-control" autocomplete="username" placeholder="Email hoặc số điện thoại" required /><span asp-validation-for="Identifier" class="text-danger small"></span></div>
        <div class="coco-auth-field"><label asp-for="Password"></label><div class="auth-password-field"><input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="Mật khẩu của bạn" required /><button class="auth-password-toggle" type="button" data-auth-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button></div><span asp-validation-for="Password" class="text-danger small"></span></div>
        <div class="coco-auth-options"><label><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label><a asp-area="" asp-controller="Account" asp-action="ForgotPassword">Quên mật khẩu</a></div>
        <button class="btn btn-wine coco-auth-submit" type="submit">Đăng nhập</button>
    </form>
    <partial name="_GoogleSignIn" />
    <p class="coco-auth-footer"><a asp-area="" asp-controller="Account" asp-action="ResendActivation">Gửi lại mã kích hoạt</a></p>
</section>
