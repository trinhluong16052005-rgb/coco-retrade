@model LinkGoogleForm
@{ ViewData["Title"] = "Liên kết Google"; }
<div class="auth-form-panel mx-auto my-4" style="max-width:560px">
    <h1 class="page-title">Liên kết Google</h1>
    <p>Xác nhận mật khẩu CoCo, sau đó chọn Google có cùng email. Những lần sau bạn có thể đăng nhập bằng Google.</p>
    <form method="post" asp-action="LinkGoogle">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <label asp-for="CurrentPassword" class="form-label"></label>
        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        <button type="submit" class="btn btn-wine w-100 mt-3">Xác nhận và tiếp tục với Google</button>
    </form>
</div>
