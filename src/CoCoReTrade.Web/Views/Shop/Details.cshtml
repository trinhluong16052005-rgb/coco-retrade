@model ProductDetails
@inject MarketplacePolicy OfferPolicy
@inject ShippingPolicy Shipping
@inject CoCoReTrade.Web.Demo.DemoCatalog Demo
@{
    ViewData["Title"] = Model.Name;
    ViewBag.AlignProductCards = true;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isSeller = Model.SellerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var canPurchase = Model.Status == ProductStatus.Active && !isSeller;
    var sellerProfile = (UserProfileDto?)ViewBag.SellerProfile;
    var demoProduct = Demo.Find(Model.Sku);
    var displayDescription = string.IsNullOrWhiteSpace(Model.Description) ? demoProduct?.Description : Model.Description;
    var displayColor = string.IsNullOrWhiteSpace(Model.Color) ? demoProduct?.Color : Model.Color;
}
<nav class="breadcrumbs" aria-label="Đường dẫn"><a asp-action="Index">Mua sắm</a><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chevron-right" /></svg><span>@Model.Name</span></nav>
<div class="row g-4 g-xl-5 product-detail">
    <div class="col-md-5">
        <div class="product-gallery">
            @if (Model.ImageIds.Count > 0)
            {
                <div class="detail-image-stage">
                    <img id="product-main-image" class="detail-main-image" src="/images/@Model.ImageIds[0]" alt="Ảnh 1 của @Model.Name" data-product-name="@Model.Name" />
                    @if (Model.ImageIds.Count > 1)
                    {
                        <button type="button" class="gallery-arrow gallery-arrow--previous" data-gallery-step="-1" aria-label="Ảnh trước"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></button>
                        <button type="button" class="gallery-arrow gallery-arrow--next" data-gallery-step="1" aria-label="Ảnh tiếp theo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button>
                    }
                    <button type="button" id="galleryZoom" class="gallery-zoom" aria-label="Phóng to ảnh sản phẩm" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5M7.5 10.5h6" /><path class="gallery-zoom-plus" d="M10.5 7.5v6" /></svg></button>
                </div>
                <div class="thumbs" aria-label="Ảnh sản phẩm">
                    @for (var i = 0; i < Model.ImageIds.Count; i++)
                    {
                        <button class="detail-thumbnail @(i == 0 ? "is-active" : "")" type="button" data-product-image="/images/@Model.ImageIds[i]" aria-label="Xem ảnh @(i + 1) của @Model.Name" aria-pressed="@(i == 0 ? "true" : "false")"><img src="/images/@Model.ImageIds[i]" alt="" loading="lazy" /></button>
                    }
                </div>
            }
            else { <div class="detail-main-image product-placeholder"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag" /></svg></div> }
        </div>
    </div>
    <div class="col-md-7"><div class="detail-summary">
        <div class="detail-primary">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <span class="eyebrow">@Model.Brand · @UiText.For(Model.Category)</span>
                @if (demoProduct is not null) { <span class="status-pill Active">Sản phẩm mô phỏng · chưa kiểm định thực tế</span> }
                else if (Model.Status == ProductStatus.Active) { <span class="status-pill Active"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#check" /></svg> CoCo đã kiểm định</span> }
                else { <span class="status-pill @Model.Status">@UiText.For(Model.Status)</span> }
            </div>
            <h1 class="page-title mt-0">@Model.Name</h1>
            <div class="detail-price">@Model.AskingPrice.ToString("N0") <span>VNĐ</span></div>
            @if (demoProduct is not null && Model.OriginalPrice > Model.AskingPrice)
            {
                var savingPercent = decimal.Round((Model.OriginalPrice - Model.AskingPrice) / Model.OriginalPrice * 100, 0, MidpointRounding.AwayFromZero);
                <p class="small mt-1">Giá gốc mô phỏng: <del>@Model.OriginalPrice.ToString("N0") VNĐ</del> <span class="text-danger">· Tiết kiệm @savingPercent% (mô phỏng)</span></p>
            }
            else if (demoProduct is null && Model.OriginalPrice > Model.AskingPrice)
            {
                <p class="small text-muted mt-1">Giá gốc tham khảo: @Model.OriginalPrice.ToString("N0") VNĐ</p>
            }
            @if (Model.Status == ProductStatus.Rejected) { <div class="alert alert-danger mt-3"><strong>Chưa đủ điều kiện đăng bán</strong><div class="mt-1">@Model.RejectionReason</div></div> }
            @if (canPurchase)
            {
                <div class="purchase-panel">
                    <a class="btn btn-wine w-100" asp-controller="Checkout" asp-action="Index" asp-route-productId="@Model.Id">Mua ngay <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></a>
                    @if (Model.AllowOffers)
                    {
                        <a class="btn btn-outline-wine w-100 mt-2" asp-controller="Offers" asp-action="Make" asp-route-productId="@Model.Id">Đề xuất mức giá của bạn</a>
                        <p class="form-text text-center mb-3 detail-offer-desktop">Bạn có thể đề xuất giảm tối đa @OfferPolicy.MaximumOfferDiscountPercent%.</p>
                    }
                    @if (isAuthenticated)
                    {
                        <div class="row g-2 mt-1 detail-utilities-desktop">
                            <div class="col-6"><form asp-controller="Cart" asp-action="Add" method="post" data-cart-add><input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" /><button type="submit" class="btn btn-light w-100"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#bag" /></svg> Thêm vào giỏ</button></form></div>
                            <div class="col-6"><form asp-controller="Messages" asp-action="Start" method="post"><input type="hidden" name="productId" value="@Model.Id" /><button type="submit" class="btn btn-light w-100"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#message" /></svg> Nhắn người bán</button></form></div>
                        </div>
                    }
                    @if (Model.PublishedAtUtc.HasValue)
                    {
                        var publishedLocal = new DateTimeOffset(Model.PublishedAtUtc.Value, TimeSpan.Zero)
                            .ToOffset(TimeSpan.FromHours(Shipping.StoreUtcOffsetHours));
                        <p class="small text-muted mt-3 mb-0 detail-published-date">Ngày đăng bán: <time datetime="@publishedLocal.ToString("yyyy-MM-ddTHH:mm:sszzz")">@publishedLocal.ToString("dd/MM/yyyy")</time></p>
                    }
                    @if (demoProduct is not null)
                    {
                        <p class="purchase-note">Đặt hàng chỉ để thử quy trình. Không giao hàng hoặc thu tiền thật.</p>
                    }
                </div>
            }
        </div>
        @if (canPurchase)
        {
            <div class="detail-utilities-mobile" aria-label="Thao tác sản phẩm">
                @if (Model.AllowOffers) { <span class="detail-offer-limit">Đề xuất giảm tới @OfferPolicy.MaximumOfferDiscountPercent%</span> }
                @if (isAuthenticated)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" data-cart-add><input type="hidden" name="productId" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" /><button type="submit" class="btn btn-light">Thêm vào giỏ</button></form>
                    <form asp-controller="Messages" asp-action="Start" method="post"><input type="hidden" name="productId" value="@Model.Id" /><button type="submit" class="btn btn-light">Nhắn người bán</button></form>
                }
                else
                {
                    <a class="btn btn-light" asp-controller="Account" asp-action="Login">Thêm vào giỏ</a>
                    <a class="btn btn-light" asp-controller="Account" asp-action="Login">Nhắn người bán</a>
                }
            </div>
        }
        <section class="detail-information" aria-labelledby="detail-information-title">
            <h2 id="detail-information-title">Thông tin sản phẩm</h2>
            <dl class="detail-facts">
                <div><dt>Thương hiệu</dt><dd>@Model.Brand</dd></div>
                <div><dt>Danh mục</dt><dd>@UiText.For(Model.Category)</dd></div>
                <div><dt>Kích cỡ</dt><dd>@UiText.For(Model.Size)</dd></div>
                @if (!string.IsNullOrWhiteSpace(displayColor)) { <div><dt>Màu sắc</dt><dd>@displayColor</dd></div> }
                <div><dt>Độ mới</dt><dd>@(Model.VerifiedCondition ?? Model.DeclaredCondition)%</dd></div>
                @if (!string.IsNullOrWhiteSpace(Model.Sku)) { <div><dt>Mã sản phẩm</dt><dd>@Model.Sku</dd></div> }
                else if (!string.IsNullOrWhiteSpace(Model.ConsignmentCode)) { <div><dt>Mã chờ duyệt</dt><dd>@Model.ConsignmentCode</dd></div> }
            </dl>
            @if (!string.IsNullOrWhiteSpace(displayDescription))
            {
                <div class="detail-description"><h3 class="h6">Mô tả món đồ</h3><p style="white-space:pre-line;overflow-wrap:anywhere">@displayDescription</p></div>
            }
        </section>
        @if (demoProduct is not null)
        {
            <details class="demo-product-note detail-source">
                <summary>Thông tin minh họa và nguồn ảnh</summary>
                <div>
                    <p>@demoProduct.Description</p>
                    <p>Màu: @demoProduct.Color · Giá nguồn: @demoProduct.ReferencePriceGbp.ToString("N2") GBP · Ảnh: @demoProduct.ImageCredit</p>
                    <a href="@demoProduct.SourceUrl" target="_blank" rel="noopener noreferrer">Xem listing tham khảo gốc: @demoProduct.SourceTitle</a>
                    <p>Dữ liệu phục vụ môn học, không phải hàng ký gửi thực tế của CoCo.</p>
                </div>
            </details>
        }
        @if (Model.Status == ProductStatus.Active && isAuthenticated)
        {
            <form asp-controller="Social" asp-action="Favorite" method="post" class="mt-3" data-favorite data-product-name="@Model.Name">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="selected" value="@((bool)ViewBag.IsFavorite ? "false" : "true")" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <button type="submit" class="btn btn-link text-link p-0" aria-pressed="@((bool)ViewBag.IsFavorite ? "true" : "false")"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg> <span data-favorite-label>@((bool)ViewBag.IsFavorite ? "Đã lưu · Bỏ lưu món đồ" : "Lưu món đồ để xem sau")</span></button>
            </form>
        }
        @if (Model.Status == ProductStatus.Active && sellerProfile is not null)
        {
            <section class="seller-card" aria-label="Thông tin người ký gửi">
                @if (sellerProfile.HasAvatar) { <img class="seller-card-avatar" src="/avatars/@sellerProfile.Id" alt="" width="52" height="52" loading="lazy" /> }
                else { <span class="seller-card-avatar seller-card-avatar-empty" aria-hidden="true"><svg class="icon"><use href="/images/icons.svg#user" /></svg></span> }
                <div class="seller-card-info"><strong>Người ký gửi: @sellerProfile.FullName</strong><span>Điểm tín nhiệm: @sellerProfile.TrustScore/100 · Đã bán @sellerProfile.SoldCount món</span></div>
                <a class="btn btn-outline-wine seller-card-link" asp-controller="Sellers" asp-action="Index" asp-route-id="@Model.SellerId">Xem gian hàng</a>
            </section>
        }
        @if (isSeller && Model.Status == ProductStatus.PendingApproval)
        {
            <div class="panel mt-4">
                <p class="small subtitle mb-2">@(Model.PreliminaryStatus == PreliminaryReviewStatus.Approved ? "Đã duyệt sơ bộ. Vui lòng mang món đồ đến CoCo để kiểm định trực tiếp." : Model.PreliminaryStatus == PreliminaryReviewStatus.ChangesRequested ? "CoCo yêu cầu cập nhật thông tin trước khi duyệt sơ bộ." : "Sản phẩm đang chờ duyệt sơ bộ qua ảnh.")</p>
                @if (!string.IsNullOrWhiteSpace(Model.PreliminaryReason)) { <p class="text-danger small">@Model.PreliminaryReason</p> }
                @if (Model.PreliminaryStatus != PreliminaryReviewStatus.Approved) { <a class="btn btn-outline-wine" asp-area="" asp-controller="Listing" asp-action="Edit" asp-route-id="@Model.Id">Sửa thông tin và ảnh</a> }
            </div>
        }
        @if (User.HasClaim(StaffPermissions.ClaimType, StaffPermissions.ReadPending) && Model.Status == ProductStatus.PendingApproval)
        {
            <div class="panel mt-4"><p class="small subtitle mb-2">@(Model.PreliminaryStatus == PreliminaryReviewStatus.Approved ? "Chờ kiểm định hiện vật tại tiệm." : "Chờ duyệt sơ bộ qua ảnh.")</p><a class="btn btn-wine" asp-area="Admin" asp-controller="Inspection" asp-action="Review" asp-route-id="@Model.Id">Mở phiếu duyệt <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow-right" /></svg></a></div>
        }
    </div></div>
</div>
@if (ViewBag.ComplementaryProducts is IReadOnlyList<ProductCard> complementary && complementary.Count > 0)
{ ViewBag.ProductRail = true; <section class="recommendations detail-recommendations"><h2>Sản phẩm bạn có thể thích</h2><partial name="_ProductGrid" model="complementary" /></section> }
@if (ViewBag.SimilarProducts is IReadOnlyList<ProductCard> similar && similar.Count > 0)
{ ViewBag.ProductRail = true; <section class="recommendations detail-recommendations"><h2>Sản phẩm tương tự</h2><partial name="_ProductGrid" model="similar" /></section> }
@section Scripts {
    <script>
        const thumbs = Array.from(document.querySelectorAll('[data-product-image]'));
        const image = document.getElementById('product-main-image');
        const stage = document.querySelector('.detail-image-stage');
        const zoomButton = document.getElementById('galleryZoom');
        let current = 0;
        function setZoom(enabled) {
            stage.classList.toggle('is-zoomed', enabled);
            zoomButton.setAttribute('aria-pressed', String(enabled));
            zoomButton.setAttribute('aria-label', enabled ? 'Thu nhỏ ảnh sản phẩm' : 'Phóng to ảnh sản phẩm');
            stage.style.setProperty('--zoom-x', '50%');
            stage.style.setProperty('--zoom-y', '50%');
        }
        function showImage(index) {
            if (!thumbs.length) return;
            if (stage.classList.contains('is-zoomed')) setZoom(false);
            current = (index + thumbs.length) % thumbs.length;
            const src = thumbs[current].dataset.productImage;
            image.src = src;
            image.alt = `Ảnh ${current + 1} của ${image.dataset.productName}`;
            thumbs.forEach((item, position) => {
                const active = position === current;
                item.classList.toggle('is-active', active);
                item.setAttribute('aria-pressed', String(active));
            });
        }
        thumbs.forEach((button, index) => button.addEventListener('click', () => showImage(index)));
        document.querySelectorAll('[data-gallery-step]').forEach(button =>
            button.addEventListener('click', () => showImage(current + Number(button.dataset.galleryStep))));
        zoomButton?.addEventListener('click', () => setZoom(!stage.classList.contains('is-zoomed')));
        stage?.addEventListener('pointermove', event => {
            if (!stage.classList.contains('is-zoomed') || event.target.closest('button')) return;
            const bounds = stage.getBoundingClientRect();
            stage.style.setProperty('--zoom-x', `${Math.max(0, Math.min(100, (event.clientX - bounds.left) / bounds.width * 100))}%`);
            stage.style.setProperty('--zoom-y', `${Math.max(0, Math.min(100, (event.clientY - bounds.top) / bounds.height * 100))}%`);
        });
        showImage(0);
    </script>
}
