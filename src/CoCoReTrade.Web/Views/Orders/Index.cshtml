@model IReadOnlyList<OrderDto>
@{ ViewData["Title"] = "Đơn hàng của tôi"; var me = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<div class="eyebrow mt-4">Giao dịch</div><h1 class="page-title">Đơn hàng của tôi</h1>
<form method="get" class="d-flex gap-2 mb-3" role="search"><label class="visually-hidden" for="my-order-search">Tìm đơn hàng</label><input id="my-order-search" name="search" type="search" class="form-control" value="@ViewBag.Search" placeholder="Mã đơn, mã sản phẩm hoặc tên sản phẩm" /><button class="btn btn-outline-wine" type="submit">Tìm kiếm</button></form>
@if (Model.Count == 0) { <div class="empty-state">Chưa có đơn hàng. <a asp-controller="Shop" asp-action="Index">Khám phá sản phẩm →</a></div> }
else
{
    <div class="row g-3 mb-5">
    @foreach (var order in Model)
    {
        <div class="col-md-6"><a class="panel offer-card d-block h-100" asp-action="Details" asp-route-id="@order.Id">
            <div class="d-flex justify-content-between gap-2"><span class="eyebrow">@order.OrderCode</span><span class="status-pill">@(order.Status == OrderStatus.Completed ? order.Fulfillment == FulfillmentType.Shipping ? "Giao hàng thành công" : "Đã nhận tại CoCo" : UiText.For(order.Status))</span></div>
            <h2 class="display-serif fs-4 mt-2">@order.ProductName</h2>
            <p class="small text-muted">@order.ProductSku · @(order.BuyerId == me ? "Bạn mua" : "Bạn bán") · @UiText.For(order.Fulfillment) · @order.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p>
            <strong class="product-price">@order.TotalAmount.ToString("N0") VNĐ</strong>
        </a></div>
    }
    </div>
}
